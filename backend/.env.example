# ============================================================
# RacePulse - Environment Variables (example)
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-secret

# ------------------------------------------------------------
# Database (PostgreSQL with pg8000 driver)
# ------------------------------------------------------------
# For Neon (serverless Postgres), use pg8000 with SSL:
# postgresql+pg8000://user:password@hostname:5432/dbname?sslmode=require
# For local development with Neon:
DATABASE_URL=postgresql+pg8000://racepulse:racepulse@localhost:5432/racepulse?sslmode=require

# ------------------------------------------------------------
# Cache (Redis)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------
# AI / RAG (planned — leave blank until Phase 8)
# ------------------------------------------------------------
AI_API_KEY=

# ------------------------------------------------------------
# Production requirements
# ------------------------------------------------------------
# SECRET_KEY must be set in production. The app will fail to start
# if SECRET_KEY is missing when ENVIRONMENT=production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"